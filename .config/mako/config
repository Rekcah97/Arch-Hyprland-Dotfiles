# Look
font=JetBrainsMono Nerd Font 11
background-color=#1e1e2ee6
text-color=#cdd6f4
border-color=#89b4fa
progress-color=over #313244
border-size=1
border-radius=7
padding=14,18
margin=6
outer-margin=12

# Size and position
anchor=top-right
layer=overlay
width=360
height=150
max-visible=4
sort=+time

# Icons
icons=1
max-icon-size=48

# Behavior
default-timeout=5000
ignore-timeout=1
markup=1
format=<b>%s</b>\n%b



[urgency=low]
border-color=#585b70
default-timeout=3000

[urgency=critical]
border-color=#f38ba8
default-timeout=0

[mode=do-not-disturb]
invisible=1

[hidden]
format=+%h more notifications
text-alignment=center
background-color=#313244e6
text-color=#a6adc8
border-color=#585b70
border-size=1
padding=8,16

[summary="Battery Critical"]
format=<span foreground="#f38ba8"><b>%s</b></span>\n%b
default-timeout=0

[summary="Battery Critical - Suspending"]
format=<span foreground="#f38ba8"><b>%s</b></span>\n%b
default-timeout=0

[summary="Battery Low"]
format=<span foreground="#f9e2af"><b>%s</b></span>\n%b
default-timeout=8000

[summary="Charge Limit Reached"]
format=<span foreground="#a6e3a1"><b>%s</b></span>\n%b
default-timeout=8000

[summary="Battery Full"]
format=<span foreground="#a6e3a1"><b>%s</b></span>\n%b
default-timeout=8000

[summary="Charger Connected"]
format=<span foreground="#94e2d5"><b>%s</b></span>\n%b
default-timeout=3000

[summary="Charger Disconnected"]
format=<span foreground="#fab387"><b>%s</b></span>\n%b
default-timeout=3000